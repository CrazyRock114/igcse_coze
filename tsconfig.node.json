{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "noEmit": true,
    // `vite/client` is here only to declare `import.meta.glob`, which `src/lib/registry.ts`
    // uses. Nothing in this project runs it — it is type-checked, not executed.
    "types": ["node", "vite/client"],
    // The check scripts run under tsx, which resolves ESM specifiers literally and
    // therefore needs the `.ts` extension written out.
    "allowImportingTsExtensions": true
  },
  // Content modules are pulled in by the scripts, so they belong to this project too.
  // `src/lib` is taken wholesale rather than file by file: a kernel may import any of it,
  // and a hand-maintained list breaks the build the first time someone forgets to add to
  // it — which is a failure that only shows up in `tsc -b`, not in the dev server.
  // (vite.config is deliberately a .mjs file, not type-checked here — see its header.)
  "include": ["scripts/**/*.ts", "src/content/**/*.ts", "src/lib/**/*.ts"],
  // gen-narration-audio is a Coze-sandbox-only offline tool: it imports
  // `coze-coding-dev-sdk`, which is not on npm and not resolvable outside that
  // sandbox, so `tsc -b` there would fail with TS2307 even though the script
  // never participates in the build output. It runs under tsx (no type-check).
  "exclude": ["src/**/*.test.ts", "scripts/gen-narration-audio.ts"]
}
