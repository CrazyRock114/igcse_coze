[project]
requires = ["nodejs-24"]

[dev]
build = ["pnpm", "install"]
run = ["sh", "-c", "pnpm run dev --port ${DEPLOY_RUN_PORT}"]

[deploy]
build = ["bash", "-c", "pnpm install && pnpm run build"]
# vite preview bundles its config into node_modules/.vite-temp before serving,
# which the deployment runtime cannot create (ENOENT). Use the zero-dependency
# static server instead (reads DEPLOY_RUN_PORT itself; SPA fallback + audio MIME).
run = ["sh", "-c", "node scripts/serve-dist.mjs"]
