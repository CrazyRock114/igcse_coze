# Copy to .env.local and fill in real values for local dev.
# .env.local is gitignored. In production, GitHub Actions reads
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY from repo secrets.

# Supabase project URL — looks like https://abcdefg.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon public key — the long eyJ... JWT, NOT the service_role key
VITE_SUPABASE_ANON_KEY=eyJ...
