{
  "name": "science-igcse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bilingual (EN-primary, ZH-scaffolded) interactive science courses for international curricula, starting with Cambridge IGCSE Physics 0625",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check:content && tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:syllabus": "tsx scripts/check-syllabus-coverage.ts",
    "check:content": "tsx scripts/check-content-integrity.ts && tsx scripts/check-syllabus-coverage.ts",
    "audit": "tsx scripts/audit-content.ts",
    "readme": "tsx scripts/update-readme.ts",
    "qa:routes": "node scripts/qa-routes.mjs",
    "predev": "tsx scripts/gen-lesson-index.ts",
    "prebuild": "tsx scripts/gen-lesson-index.ts",
    "gen:lesson-index": "tsx scripts/gen-lesson-index.ts",
    "qa:bundle": "node scripts/check-bundle-budget.mjs",
    "gen:narration": "tsx scripts/gen-narration-audio.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.1",
    "katex": "^0.16.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "three": "^0.185.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.9.0",
    "jsdom": "^28.0.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.6"
  }
}